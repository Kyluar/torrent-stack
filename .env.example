# User permissions
PUID=1000
PGID=1000

# Timezone - https://en.wikipedia.org/wiki/List_of_tz_database_time_zones#List
TZ=Etc/UTC

# Paths
CONFIG_PATH=./config
DOWNLOADS_PATH=./downloads

# jackett
AUTO_UPDATE=true
RUN_OPTS= #optional

#flaresolverr
LOG_LEVEL=info
LOG_FILE=none
LOG_HTML=false
CAPTCHA_SOLVER=none

# qBittorrent
QBITTORRENT_WEBUI_PORT=8080
QBITTORRENT_TORRENTING_PORT=6881